@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  * {
    @apply border-border;
  }
  body {
    @apply bg-background text-foreground;
  }
}

@font-face {
    font-family: MonaspaceNeon;
    src: url("/src/fonts/MonaspaceNeonVarVF[wght,wdth,slnt].ttf");
}

@font-face {
    font-family: MonaspaceKrypton;
    src: url("/src/fonts/MonaspaceKryptonVarVF[wght,wdth,slnt].ttf");
}

body {
    background-color: #090909;
    font-family: 'MonaspaceKrypton', monospace;
}

h1, h2, h3, h4, h5 {
    font-family: 'MonaspaceNeon', sans-serif;
}

:root {
    --border-width: 0.55em;
    --edge-size: 0.55em;
    --bevel-depth: 0.4em;
}

.polygonR {
    clip-path: polygon(
        var(--edge-size) 0%,
        100% 0,
        100% calc(100% - var(--edge-size)),
        calc(100% - var(--edge-size)) 100%,
        0 100%,
        0% var(--edge-size)
    );
}

.polygonL {
	clip-path: polygon(
		calc(100% - var(--edge-size)) 0%, 
		100% var(--edge-size), 
		100% 100%, 
		var(--edge-size) 100%,
		0% calc(100% - var(--edge-size)),
		0 0
	);
}

.polygonF {
    clip-path: polygon(
    20% 0%, 
    80% 0%, 
    100% 20%, 
    100% 80%,
    80% 100%,
    20% 100%, 
    0% 80%, 
    0% 20%);
}

.btn-primary {
    @apply bg-green-600 hover:bg-green-800 active:bg-green-500 p-2 transition-all polygonL mr-3
}

.btn-error {
    @apply bg-red-600 hover:bg-red-800 active:bg-red-500 p-2 transition-all polygonL mr-3
}

input, select {
	outline: none;
}

::-webkit-scrollbar {
	width: .55vw;
}

::-webkit-scrollbar-track {
	background: hsl(240, 4%, 15%);
	border-radius: .2vw;
}

::-webkit-scrollbar-thumb {
	background: hsl(240, 4%, 7%);
	border-radius: .2vw;
}

::-webkit-scrollbar-thumb:hover {
	background: hsl(240, 4%, 10%);
}

@supports(scrollbar-color) {
	scrollbar-color: #27272 ahsl(240, 4%, 5%);
	scrollbar-width: thin;
}
